{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webcli.app/schema/1.json",
  "title": "webCLI family index, schema 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "family", "site", "updated", "contract", "audit", "example", "tools", "planned"],
  "properties": {
    "schema": { "const": 1 },
    "family": { "type": "string" },
    "site": { "type": "string", "pattern": "^https://" },
    "updated": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input", "output", "method", "egress", "account", "run_param", "result_handle", "status_selector", "status_values", "deterministic"],
      "properties": {
        "input": { "const": "URL" },
        "output": { "const": "artifact" },
        "method": { "const": "GET" },
        "egress": { "const": "none" },
        "account": { "const": false },
        "run_param": { "type": "string" },
        "result_handle": { "type": "string" },
        "status_selector": { "type": "string" },
        "status_values": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "deterministic": { "const": true }
      }
    },
    "audit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "title", "url"],
      "properties": {
        "tool": { "type": "string" },
        "title": { "type": "string" },
        "url": { "type": "string", "pattern": "^https://" }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "path", "params", "result", "artifact_sha256", "verified"],
      "properties": {
        "tool": { "type": "string" },
        "path": { "type": "string" },
        "params": {
          "type": "object",
          "additionalProperties": { "anyOf": [{ "type": "string" }, { "type": "array", "items": { "type": "string" } }] }
        },
        "result": { "type": "object" },
        "artifact_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "verified": { "type": "string" }
      }
    },
    "tools": { "type": "array", "items": { "$ref": "#/$defs/tool" } },
    "planned": { "type": "array", "items": { "$ref": "#/$defs/planned" } }
  },
  "$defs": {
    "tool": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "origin", "role", "inputs", "outputs", "params", "result", "testids", "agent", "status", "caveat", "source", "licence"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "origin": { "type": "string", "pattern": "^https://[^/]+/$" },
        "role": { "type": "string", "minLength": 1 },
        "inputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "outputs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
        "params": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "required", "repeatable", "description"],
            "properties": {
              "name": { "type": "string" },
              "required": { "type": "boolean" },
              "repeatable": { "type": "boolean" },
              "values": { "type": "array", "items": { "type": "string" } },
              "description": { "type": "string" }
            }
          }
        },
        "result": {
          "oneOf": [
            { "type": "null" },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["handle", "shape"],
              "properties": { "handle": { "type": "string" }, "shape": { "type": "string" } }
            }
          ]
        },
        "testids": { "type": "array", "items": { "type": "string" } },
        "agent": { "type": "boolean", "description": "true when the tool implements run= and the result handle" },
        "status": { "const": "live" },
        "caveat": { "type": ["string", "null"] },
        "source": { "type": ["string", "null"], "pattern": "^https://" },
        "licence": { "type": ["string", "null"] }
      },
      "if": { "properties": { "agent": { "const": true } } },
      "then": { "properties": { "result": { "type": "object" }, "params": { "minItems": 1 } } },
      "else": { "properties": { "result": { "type": "null" } } }
    },
    "planned": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "note"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9-]+$" },
        "status": { "enum": ["spec", "decided", "origin-move"] },
        "note": { "type": "string" },
        "egress": { "const": "cloud-tier" }
      }
    }
  }
}
