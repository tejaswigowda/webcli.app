{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://webcli.app/schema/4.json",
  "title": "webCLI family index, schema 4",
  "type": "object",
  "required": ["schema", "family", "site", "updated", "tools", "libraries"],
  "properties": {
    "schema": { "const": 4 },
    "family": { "type": "string" },
    "site": { "type": "string", "format": "uri" },
    "updated": { "type": "string", "format": "date" },
    "tools": {
      "type": "array",
      "items": { "$ref": "#/$defs/tool" }
    },
    "libraries": {
      "type": "array",
      "items": { "$ref": "#/$defs/library" }
    }
  },
  "$defs": {
    "common": {
      "type": "object",
      "required": ["kind", "id", "version", "live", "repo", "licence", "agent", "boundary", "measured"],
      "properties": {
        "kind": { "type": "string" },
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "live": {
          "oneOf": [
            { "const": "none" },
            { "type": "string", "format": "uri", "pattern": "^https://" }
          ]
        },
        "repo": { "type": "string", "format": "uri", "pattern": "^https://github\\.com/" },
        "licence": { "type": "string", "minLength": 1 },
        "agent": { "type": "boolean" },
        "boundary": { "type": "string", "minLength": 1 },
        "measured": { "enum": ["measured", "partial", "pending"] }
      }
    },
    "tool": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["kind", "name", "state", "limits", "line"],
          "properties": {
            "kind": { "const": "tool" },
            "name": { "type": "string", "minLength": 1 },
            "state": { "enum": ["working", "early", "planned"] },
            "limits": { "type": "string", "minLength": 1 },
            "line": { "type": "object" }
          }
        }
      ]
    },
    "library": {
      "allOf": [
        { "$ref": "#/$defs/common" },
        {
          "type": "object",
          "required": ["kind", "name", "description"],
          "properties": {
            "kind": { "const": "library" },
            "name": { "type": "string", "minLength": 1 },
            "description": { "type": "string", "minLength": 1 }
          }
        }
      ]
    }
  }
}
